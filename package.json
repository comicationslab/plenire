{
  "name": "plenire",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000",
    "dev:api": "tsx watch server/index.ts",
    "demo": "tsx server/demo.ts",
    "test": "node --import tsx --test --test-concurrency=1 \"server/tests/*.test.ts\"",
    "lint": "tsc --noEmit && tsc -p tsconfig.server.json",
    "build": "npm run lint && vite build",
    "preview": "vite preview",
    "dev:all": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev\""
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@hono/node-server": "^2.1.3",
    "@tanstack/react-query": "^5.104.0",
    "hono": "^4.13.12",
    "jose": "^6.2.12",
    "lucide-react": "^0.546.0",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router": "^8.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
